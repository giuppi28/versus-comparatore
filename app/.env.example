# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# mock | supabase
NEXT_PUBLIC_DATA_SOURCE=

# Server-only
SUPABASE_PROJECT_REF=
RESEND_API_KEY=
# Shared secret passed to create_lead/update_lead/complete_lead by the server routes only
# (32 random bytes, hex). The DB stores only its SHA-256 (private.app_secrets); it must match the hash
# written by the migration (rotation: supabase/README.md). Never expose to the browser.
LEAD_API_SECRET=

# Admin MOCK auth (tests/local dev only, NEXT_PUBLIC_DATA_SOURCE=mock; refused in production)
ADMIN_MOCK_EMAIL=
ADMIN_MOCK_PASSWORD=
# at least 32 characters
ADMIN_MOCK_SESSION_SECRET=

# New-lead email (Resend). Without RESEND_API_KEY or RESEND_FROM the notification is only logged.
RESEND_FROM=
# FALLBACK recipient for the new-lead email, used only when settings.notification_email is
# empty/invalid or unreadable. Order: complete_lead result -> settings.notification_email -> NOTIFICATION_EMAIL.
NOTIFICATION_EMAIL=
# Public base URL of the site (no trailing slash), used for the lead link in the email.
NEXT_PUBLIC_SITE_URL=

# Vercel Cron: Vercel sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/keepalive.
# Random string (e.g. openssl rand -hex 32). If unset, the route refuses every request in
# production; in local development it is open.
CRON_SECRET=
