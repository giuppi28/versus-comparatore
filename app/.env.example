# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# mock | supabase
NEXT_PUBLIC_DATA_SOURCE=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only
SUPABASE_PROJECT_REF=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Shared secret passed to create_lead/update_lead/complete_lead by the server routes only
# (32 random bytes, hex). The DB stores only its SHA-256 (private.app_secrets). Never expose to the browser.
LEAD_API_SECRET=

# Admin MOCK auth (tests/local dev only, NEXT_PUBLIC_DATA_SOURCE=mock; refused in production)
ADMIN_MOCK_EMAIL=
ADMIN_MOCK_PASSWORD=
# at least 32 characters
ADMIN_MOCK_SESSION_SECRET=

# New-lead email (Resend). Without RESEND_API_KEY or RESEND_FROM the notification is only logged.
RESEND_FROM=
# Fallback recipient for the new-lead email. REQUIRED with NEXT_PUBLIC_DATA_SOURCE=supabase
# (settings.notification_email is admin-only under RLS, so the lead API cannot read it).
NOTIFICATION_EMAIL=
# Public base URL of the site (no trailing slash), used for the lead link in the email.
NEXT_PUBLIC_SITE_URL=
